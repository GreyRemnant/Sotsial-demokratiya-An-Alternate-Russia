on-arrival: {!
// set up the infrastructure
Q.rsrpi_formed = 1;
Q.parties.push('rsrpi');

Q.workers_rsrpi = 10;
Q.workers_rsdrp -= 3;
Q.new_middle_rsrpi = 1;
Q.old_middle_rsrpi = 0;
Q.rural_rsrpi = 0;
Q.unemployed_rsrpi = 2;
Q.catholics_rsrpi = 0;

Q.workers_other -= 5;

if (Q.unions_independent) {
    Q.workers_rsrpi += 8;
}

// update all records
Q.rsrpi_r = 0;
Q.old_rsrpi_r = 0;
for (var record of Q.election_records) {
    record['rsrpi'] = 0;
}
for (var record of Q.party_support_records) {
    record['rsrpi'] = 0;
}
!}
