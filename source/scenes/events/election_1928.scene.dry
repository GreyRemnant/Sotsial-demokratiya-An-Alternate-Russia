    Q.next_election_month -= 12;
    Q.next_election_year = Q.year + 1;
} else {
    Q.next_election_year = Q.year;
}
Q.pro_republic -= 5;
Q.workers_rsdrp -= 3;
Q.new_middle_rsdrp -= 3;
Q.old_middle_rsdrp -= 3;
Q.rural_rsdrp -= 3;
Q.catholics_rsdrp -= 3;
Q.workers_nts += 5;
Q.old_middle_nts += 3;
Q.new_middle_nts += 3;
Q.rural_nts += 3;
Q.unemployed_nts += 5;
if (Q.pro_republic < 45 && Q.pro_republic >= 38) {
    Q.workers_rsdrp -= 6;
}
if (Q.pro_republic < 38) {
    Q.workers_rsdrp *= 0.85;
    Q.new_middle_rsdrp -= 5;
    Q.old_middle_rsdrp -= 5;
    Q.rural_rsdrp -= 5;
    Q.catholics_rsdrp -= 3;
    Q.workers_nts += 5;
    Q.old_middle_nts += 5;
    Q.new_middle_nts += 5;
    Q.rural_nts += 5;
    Q.unemployed_nts += 5;   
}
!}
