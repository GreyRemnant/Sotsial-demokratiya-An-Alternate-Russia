title: Election Simulation
set-jump: post_election


- @1928: 1928 historical scenario
- @1930: 1930 historical scenario
- @1932: 1932 (July) historical scenario

@1928
on-arrival: {!
Q.workers = 33; // industry and trade
Q.old_middle = 13; // "bourgeoisie"
// 16.4 trade & commerce, 6.6 public and private services, 4.4 domestic help
Q.new_middle = 10; // "intelligensia"
Q.rural = 44; // agriculture and forestry employment... but many of those are proletarians so...
// source: https://surface.syr.edu/cgi/viewcontent.cgi?filename=3&article=1016&context=books&type=additional page 43, table 3.3
Q.unemployed = 8.6;
Q.catholics = 12;

Q.classes = ['workers', 'old_middle', 'new_middle', 'rural', 'unemployed', 'catholics'];
Q.parties = ['rsdrp', 'rkp', 'plsr', 'psr', 'musavat', 'kadets', 'vs', 'nts', 'other', 'otherleft'];

// Support for party by social group
// they don't have to sum to 100 since the electoral calculations will be normalized.
QQ.workers_rsdrp = 65;
Q.workers_rkp = 15;
Q.workers_psr = 2;
Q.workers_plsr = 1;
Q.workers_musavat = 6;
Q.workers_kadets = 6;
Q.workers_vs = 1;
Q.workers_nts = 3;
Q.workers_other = 3;

Q.old_middle_rsdrp = 13;
Q.old_middle_otherleft = 2;
Q.old_middle_rkp = 0;
Q.old_middle_psr = 1;
Q.old_middle_plsr = 0;
Q.old_middle_musavat= 3;
Q.old_middle_kadets = 55;
Q.old_middle_vs = 11;
Q.old_middle_nts = 4;
Q.old_middle_other = 10;

Q.new_middle_rsdrp = 10;
Q.new_middle_otherleft = 7;
Q.new_middle_rkp = 0;
Q.new_middle_psr = 5;
Q.new_middle_plsr = 1;
Q.new_middle_musavat = 10;
Q.new_middle_kadets = 40;
Q.new_middle_vs = 15;
Q.new_middle_nts = 3;
Q.new_middle_other = 5;

Q.rural_rsdrp = 3;
Q.rural_otherleft = 10;
Q.rural_rkp = 0;
Q.rural_psr = 53;
Q.rural_plsr = 8;
Q.rural_musavat= 9;
Q.rural_kadets = 10;
Q.rural_vs = 15;
Q.rural_nts = 5;
Q.rural_other = 5;

Q.unemployed_rsdrp = 20;
Q.unemployed_otherleft = 10;
Q.unemployed_rkp = 40;
Q.unemployed_psr = 0;
Q.unemployed_plsr = 30;
Q.unemployed_musavat = 0;
Q.unemployed_kadets = 0;
Q.unemployed_vs = 5;
Q.unemployed_nts = 25;
Q.unemployed_other = 5;

Q.catholics_rsdrp = 10;
Q.catholics_otherleft = 10;
Q.catholics_rkp = 5;
Q.catholics_psr = 40;
Q.catholics_psr = 3;
Q.catholics_musavat = 0;
Q.catholics_kadets = 5;
Q.catholics_vs = 5;
Q.catholics_nts = 10;
Q.catholics_other = 5;
!}
